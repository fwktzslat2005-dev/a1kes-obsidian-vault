**/build/

# Local dependency/cache folders
**/.python_deps/
**/__pycache__/
.venv/
node_modules/

# Large source/output documents
pdf/
**/*.pdf
**/*.docx
**/*.pptx
**/*.xlsx

# Common OS/editor noise
.DS_Store
Thumbs.db
desktop.ini
