# Obsidian local state
.obsidian/workspace*.json

# Obsidian plugin packages: keep settings/manifests, ignore downloaded code
.obsidian/plugins/*/*
!.obsidian/plugins/*/data*.json
!.obsidian/plugins/*/manifest.json
!.obsidian/plugins/*/brat-migrations.json

# Assistant/session local state
.claudian/sessions/

# Trash and generated caches
.trash/
